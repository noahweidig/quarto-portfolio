{
  "name": "noahweidig-site",
  "private": true,
  "description": "Build and quality-check tooling for noahweidig.com (the site itself is rendered by Quarto).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "quarto render",
    "preview": "quarto preview",
    "globe": "node scripts/generate-globe-svg.mjs",
    "a11y": "node scripts/axe-audit.mjs",
    "validate:html": "html-validate \"_site/**/*.html\"",
    "check:quarto-pin": "./scripts/check-quarto-pin.sh",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format && npm run lint:prose",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"assets/**/*.{css,scss}\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "report:css": "node scripts/css-coverage.mjs",
    "lint:prose": "node scripts/prose-lint.mjs && cspell --no-progress \"**/*.qmd\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.13.0",
    "cspell": "^10.3.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "html-validate": "11.16.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.6",
    "puppeteer": "25.11.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript-eslint": "^8.70.1"
  }
}
